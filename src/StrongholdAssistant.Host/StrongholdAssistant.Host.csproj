<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StrongholdAssistant</AssemblyName>
    <AssemblyTitle>高效雅雅·卫戍协议助手</AssemblyTitle>
    <Product>高效雅雅·卫戍协议助手</Product>
    <ApplicationIcon>../../branding/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReleaseBuild)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForkPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);FORK_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="../../branding/icon.ico" Link="icon.ico" />
    <ProjectReference Include="../ASPAssistant.Core/ASPAssistant.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="../../data/**/*" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ui/dist/**/*" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Maa 按程序目录定位原生库、插件；数据和网页也必须留在磁盘上。 -->
  <Target Name="KeepExternalPackageFiles" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <!-- 产品不解码视频，避免视频插件封入单文件。 -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^opencv_videoio_ffmpeg'))" />
      <ResolvedFileToPublish Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '^(runtimes|plugins|data|ui)[/\\]'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="RequireBuiltUi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../ui/dist/index.html')" Text="界面产物不存在，请先运行 npm --prefix src/ui run build" />
  </Target>
</Project>
